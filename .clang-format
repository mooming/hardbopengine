# HardBop Engine — C++ formatting rules
#
# STYLE FAMILY: Allman, base LLVM.
#
#   The defining rule of this codebase: ALWAYS break the line before an
#   opening brace.
#
#       class Foo              void Bar()             if (condition)
#       {                      {                      {
#           int a;                 DoWork();              DoWork();
#       }                      }                      }
#
#   This is Allman — NOT K&R/Attach (`class Foo {`), and NOT BSD/KNF proper,
#   which keeps `if (x) {` and `namespace x {` attached and breaks only for
#   functions. Measured against Engine/CodingStandards.h/.cpp, the number of
#   constructs each named style gets wrong:
#       Allman 0   Linux/BSD 28   Stroustrup 35   WebKit 36   GNU 41   K&R 45
#
# THERE ARE NO BRACE EXEMPTIONS. An empty body still gets its braces on their
# own lines:
#
#       void Foo() noexcept      struct Empty
#       {                        {
#       }                        };
#
# WHY "Custom" EVEN THOUGH THE STYLE IS PURE ALLMAN:
#   With every SplitEmpty* flag below set to true, `BreakBeforeBraces: Allman`
#   was verified byte-identical to this explicit table (40 real sources plus a
#   probe covering every brace-bearing construct). So Allman *would* work here.
#   The explicit table is kept anyway because it loads on every clang-format
#   that has BraceWrapping at all, whereas the Allman value is newer and its
#   exact version floor is not pinned down; CLion bundles its own older
#   clang-format, and an unrecognised enum value makes the whole file fail to
#   load rather than degrading gracefully.
#   Note the reverse hazard, which bites more often: a BraceWrapping override
#   placed under a *named* style is silently ignored. Any new brace rule must be
#   added here, with BreakBeforeBraces staying Custom.
#
# AllowShortFunctionsOnASingleLine is NOT orthogonal to this — see its entry.
#
# Option spellings are deliberately kept in their long-standing scalar forms
# so this file loads identically in CLion's bundled clang-format and current
# Homebrew clang-format; several of these options became mappings/enums in
# clang-format 19-22 and the modern spellings break older versions outright.
#
# Generated from CLion C/C++ Code Style settings, then hand-curated.
---
Language: Cpp
# Measured optimal base: zero residual deviation against
# Engine/CodingStandards.h/.cpp. Google and Chromium diverge on trailing-comment
# padding and `}  // namespace`; Mozilla and GNU diverge heavily.
BasedOnStyle: LLVM

# -------------------------------------------------------------- indentation --
UseTab: Always              # tabs, never spaces
IndentWidth: 4
TabWidth: 4
AccessModifierOffset: -4    # public/protected/private sit at the class brace column
NamespaceIndentation: None  # namespace bodies start at column 0
IndentCaseLabels: true
IndentCaseBlocks: true
IndentPPDirectives: None

# ------------------------------------------------------------------ columns --
ColumnLimit: 120
ContinuationIndentWidth: 8
ConstructorInitializerAllOnOneLineOrOnePerLine: false
BreakConstructorInitializers: BeforeComma
AlwaysBreakTemplateDeclarations: Yes
LambdaBodyIndentation: OuterScope
IndentWrappedFunctionNames: false

# ------------------------------------------------------------------- braces --
# Allman, plus the one empty-body exemption noted below.
BreakBeforeBraces: Custom
BraceWrapping:
    # Allman: break before every opening brace.
    AfterNamespace: true
    AfterClass: true
    AfterStruct: true
    AfterUnion: true
    AfterEnum: true
    AfterFunction: true
    AfterControlStatement: true
    AfterCaseLabel: true
    AfterExternBlock: true
    BeforeElse: true
    BeforeCatch: true
    BeforeLambdaBody: true

    # The 'while' of a do/while stays attached (shared by Allman and KNF).
    BeforeWhile: false

    # No exemptions: an empty body still breaks before its braces and closes on
    # its own line. Verified against the pure Allman preset, which produces the
    # same output — these four lines exist to make the rule explicit locally.
    SplitEmptyFunction: true
    SplitEmptyRecord: true
    SplitEmptyNamespace: true
    IndentBraces: false

# --------------------------------------------- single-line statement sizing --
# Must stay None for the empty-brace rule to hold. Setting SplitEmptyFunction:
# true while this is Empty changes nothing: Empty collapses `void Foo() {}` back
# onto one line and wins. Both options have to agree; None is the correct pair.
# Measured matrix (SplitEmptyFunction x this option):
#     true  x Empty -> `void Foo() noexcept {}`      (exemption survives)
#     false x Empty -> `void Foo() noexcept {}`
#     true  x None  -> `void Foo() noexcept` + `{` + `}`   <- what we want
#     false x None  -> `void Foo() noexcept` + `{}`        (half split, invalid
#                                                          intent: brace pairs
#                                                          stay joined)
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: false
# Short lambdas stay inline:
#   std::signal(SIGINT, [](int) { running = false; });

# ----------------------------------------------------------------- includes --
# Layout convention — three blocks, alphabetical inside each, own header first:
#
#     #include "OwnHeader.h"            <- own header, when one exists
#
#     #include <atomic>                 <- standard headers, alphabetical
#     #include <cstring>
#
#     #include "Config/ConfigParam.h"   <- project headers, alphabetical
#     #include "Log/Logger.h"
#
#
#
#     <first code body>
#
# Preserve sorts inside each block but never reorders across blank lines, so
# the own-header / standard / project separation stays author-controlled.
# Consequence: a source file that puts project headers before standard headers
# is NOT caught by the tool — it must be caught in review.
IncludeBlocks: Preserve
IncludeCategories:
  - Regex: '^<.*'
    Priority: 2
  - Regex: '^".*'
    Priority: 3
# Lets Main.cpp match Main.h as its own header.
IncludeIsMainRegex: '(.h)?$'

# --------------------------------------------------------------- whitespace --
PointerAlignment: Left      # int* p, not int *p
ReferenceAlignment: Left
SpaceAfterCStyleCast: true
SpaceAfterTemplateKeyword: true
SpaceBeforeRangeBasedForLoopColon: true
SpaceInEmptyParentheses: false
SpacesInParentheses: false
SpacesInAngles: false
SpacesInConditionalStatement: false
AlignOperands: true
AlignTrailingComments: false
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
# The three Align* rules above stay off: no tab-padded pseudo-alignment of
# adjacent statements or trailing comments.

# ------------------------------------------------------------- blank lines --
MaxEmptyLinesToKeep: 2
EmptyLineBeforeAccessModifier: LogicalBlock
SeparateDefinitionBlocks: Always
InsertNewlineAtEOF: true
# Convention, not machine-enforceable: two empty lines between the last
# #include / #define and the first code body.

# --------------------------------------------------------------------- misc --
MacroBlockBegin: ''
MacroBlockEnd: ''
